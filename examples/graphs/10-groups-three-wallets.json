{
  "name": "Wash groups with 3 or more wallets",
  "description": "Flow groups and rings with n_wallets >= 3. pattern_type, n_buyers, and n_sellers are on the same cycles stream, so a second Condition can keep only many_to_one or many_to_many.",
  "nodes": [
    {"id": "swaps1", "type": "source", "position": {"x": 40, "y": 80}, "data": {"source": "swaps"}},
    {"id": "transfers1", "type": "source", "position": {"x": 40, "y": 280}, "data": {"source": "transfers"}},
    {"id": "detect1", "type": "detect_cycles", "position": {"x": 340, "y": 140}, "data": {"tolerance": 0.05, "window_blocks": 200, "max_group_size": 16}},
    {"id": "filter1", "type": "condition", "position": {"x": 700, "y": 80}, "data": {"mode": "compare", "field": "n_wallets", "op": ">=", "value": 3}},
    {"id": "filter2", "type": "condition", "position": {"x": 980, "y": 200}, "data": {"mode": "compare", "field": "pattern_type", "op": "=", "value": "many_to_many"}},
    {"id": "out1", "type": "output_table", "position": {"x": 1280, "y": 80}, "data": {"title": "Groups of 3+"}},
    {"id": "out2", "type": "output_table", "position": {"x": 1280, "y": 240}, "data": {"title": "Many-to-many"}}
  ],
  "edges": [
    {"id": "e1", "source": "swaps1", "target": "detect1", "sourceHandle": "out", "targetHandle": "in_swaps"},
    {"id": "e2", "source": "transfers1", "target": "detect1", "sourceHandle": "out", "targetHandle": "in_transfers"},
    {"id": "e3", "source": "detect1", "target": "filter1", "sourceHandle": "out_cycles", "targetHandle": "in"},
    {"id": "e4", "source": "filter1", "target": "out1", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e5", "source": "detect1", "target": "filter2", "sourceHandle": "out_cycles", "targetHandle": "in"},
    {"id": "e6", "source": "filter2", "target": "out2", "sourceHandle": "out", "targetHandle": "in"}
  ]
